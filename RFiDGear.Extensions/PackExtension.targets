<Project>
  <!--
    Makes an extension package (.rfext) of a built extension, for the person who runs the extension to install from RFiDGear's
    menu "File > Install extension update..." without browsing into %ProgramData%\RFiDGear\Extensions. This is the way an
    extension provider ships an update: the provider decides which files make the extension, and this step writes them, with
    the SHA-256 of each, into one archive. Nothing is executed when a package is installed, and nothing but the files listed is
    put on the machine. Imported by each extension project that wants to be shipped as a package.

    On with every build of such a project, in every configuration: a build that makes the extension makes its package as well,
    so there is nothing to remember and a package is never missing. It is written into bin\package of the project (a file of
    the build, not of its output folder, which the installers harvest), or into ExtensionPackageFolder when that is set. The
    last message of the build says where. To build without one:
      dotnet build RFiDGear.Extensions\CardCheckAssistant -p:PackExtension=false

    A package is made for one platform (the payload of an extension, such as the native sni.dll of the SQL driver, is of the
    platform that was built); the file name says which, and the version:
      <id>-<version>-<platform>.rfext             a Release build, the one that is shipped
      <id>-<version>-<platform>-<Configuration>.rfext   any other configuration (Debug), so that it never replaces the Release one
    The platform is the build's, or ExtensionPackagePlatform when the project says that its payload is for another one. A build for
    AnyCPU has no platform of its own, so a project with native payload files has to name it: the Card Check Assistant takes it from
    the sni.dll that it copied, which is the one of the operating system for AnyCPU.

    A package that cannot be made does not break a build that never asked for one: it is a warning, and the build goes on. That is
    the case for a project that has native payload files and no platform to name (AnyCPU), and for a package file that cannot be
    replaced (it is open in RFiDGear's installer, or a program holds it). A build that asks for a package by name (-p:PackExtension=true,
    on the command line or in the environment of the build) fails instead, with the reason.

    What goes in, the same files that DeployToRFiDGear.targets copies and the installers carry:
      - the project's own assembly (its name is the id of the extension),
      - RFiDGear.ExtensionLibraries.*.dll, the support libraries next to it,
      - the ExtensionPayloadFile items of the project (what a support library needs beside it and the host does not have).
    Never the contract, the SDK or the host, and no symbols: a package that holds one of the host's assemblies is refused when it
    is installed (see ExtensionPackageManifest).

    What the project sets, besides what it builds:
      - Version               the version of the extension; the assembly's file version has to be the same number, or the
                              package is refused when it is installed (the version file of the Card Check Assistant sets both),
      - ExtensionDisplayName  the name the person sees when asked whether to install it (default: the assembly's name),
      - ExtensionMinHostVersion  the oldest RFiDGear it works with (optional).
  -->
  <PropertyGroup>
    <ExtensionPackageFolder Condition="'$(ExtensionPackageFolder)' == ''">$(MSBuildProjectDirectory)\bin\package</ExtensionPackageFolder>
    <!-- Was the package asked for by name? Whatever sets PackExtension before this point (the command line, the environment, the
         project) asked; the default below is no request. It decides whether a package that cannot be made is an error. -->
    <_PackAsked Condition="'$(PackExtension)' != ''">true</_PackAsked>
    <PackExtension Condition="'$(PackExtension)' == ''">true</PackExtension>
  </PropertyGroup>

  <!-- Decides whether a package can be made, and says why not. Never fails a build that did not ask for a package. -->
  <Target Name="PackExtensionDecide" AfterTargets="Build" Condition="'$(PackExtension.Trim())' == 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <!-- The platform of the package is that of its native files, which is the build's unless the project says otherwise. -->
      <_PackPlatform Condition="'$(ExtensionPackagePlatform)' != ''">$(ExtensionPackagePlatform)</_PackPlatform>
      <_PackPlatform Condition="'$(ExtensionPackagePlatform)' == ''">$(Platform)</_PackPlatform>
      <_PackPlatformUnknown Condition="'@(ExtensionPayloadFile)' != '' And ('$(_PackPlatform)' == '' Or '$(_PackPlatform)' == 'AnyCPU')">true</_PackPlatformUnknown>
      <_PackGo>true</_PackGo>
      <_PackGo Condition="'$(_PackPlatformUnknown)' == 'true' And '$(_PackAsked)' != 'true'">false</_PackGo>
      <!-- What goes wrong while the file is written is an error for whoever asked, a warning for everybody else. -->
      <_PackContinue>WarnAndContinue</_PackContinue>
      <_PackContinue Condition="'$(_PackAsked)' == 'true'">ErrorAndStop</_PackContinue>
    </PropertyGroup>
    <Error Condition="'$(_PackPlatformUnknown)' == 'true' And '$(_PackAsked)' == 'true'"
           Text="The extension has native payload files, so its package is made for one platform. Build with -p:Platform=x64 or -p:Platform=x86, or set ExtensionPackagePlatform to the platform of the payload; AnyCPU is for a package with nothing native in it." />
    <Warning Condition="'$(_PackGo)' != 'true'"
             Text="No extension package was made: the extension has native payload files and this build is for AnyCPU, so the platform of the package is not known. Build with -p:Platform=x64 or -p:Platform=x86, or set ExtensionPackagePlatform to the platform of the payload (-p:PackExtension=false turns the package off)." />
  </Target>

  <Target Name="PackExtensionPackage" AfterTargets="PackExtensionDecide" Condition="'$(PackExtension.Trim())' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(_PackGo)' == 'true'">
    <PropertyGroup>
      <_PackName Condition="'$(ExtensionDisplayName)' != ''">$(ExtensionDisplayName)</_PackName>
      <_PackName Condition="'$(ExtensionDisplayName)' == ''">$(TargetName)</_PackName>
      <_PackStage>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)package-stage\</_PackStage>
      <!-- Release is the package that is shipped and keeps the plain name; another configuration says which it is. -->
      <_PackConfiguration Condition="'$(Configuration)' != '' And '$(Configuration)' != 'Release'">-$(Configuration)</_PackConfiguration>
      <_PackFile>$(ExtensionPackageFolder)\$(TargetName)-$(Version)-$(_PackPlatform)$(_PackConfiguration).rfext</_PackFile>
    </PropertyGroup>
    <ItemGroup>
      <_PackSource Include="$(OutDir)$(TargetName).dll" />
      <_PackSource Include="$(OutDir)RFiDGear.ExtensionLibraries.*.dll" />
      <_PackSource Include="@(ExtensionPayloadFile)" />
    </ItemGroup>

    <!-- Every step that writes follows the policy of _PackContinue (an error for a build that asked for a package, a warning for any
         other), and a step runs only when the one before it went well (MSBuildLastTaskResult), so that a failed step never leaves an
         incomplete archive: the first one that fails ends the package and the build goes on. -->
    <!-- A folder of its own and new each time: nothing of an earlier build is in the package. -->
    <RemoveDir Directories="$(_PackStage)" ContinueOnError="$(_PackContinue)" />
    <MakeDir Directories="$(_PackStage);$(ExtensionPackageFolder)" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)" />
    <Copy SourceFiles="@(_PackSource)" DestinationFolder="$(_PackStage)" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)" />

    <ItemGroup>
      <_PackStaged Include="$(_PackStage)*.dll" />
    </ItemGroup>
    <GetFileHash Files="@(_PackStaged)" Algorithm="SHA256" HashEncoding="hex" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)">
      <Output TaskParameter="Items" ItemName="_PackHashed" />
    </GetFileHash>

    <PropertyGroup>
      <_PackFiles>@(_PackHashed->'{ &quot;name&quot;: &quot;%(Filename)%(Extension)&quot;, &quot;sha256&quot;: &quot;%(FileHash)&quot; }', ', ')</_PackFiles>
      <_PackMinHost Condition="'$(ExtensionMinHostVersion)' != ''">&quot;minHostVersion&quot;: &quot;$(ExtensionMinHostVersion)&quot;, </_PackMinHost>
      <!-- The name is text of the provider's: a backslash and a quote in it are escaped for JSON, or the package could be made
           and then not installed. The platform is what the build was for (x64, x86): the installer refuses a package of the
           other one, because the payload of an extension (sni.dll) is native. -->
      <_PackNameJson>$(_PackName.Replace('\', '\\').Replace('"', '\"'))</_PackNameJson>
      <_PackManifest>{ &quot;schema&quot;: 1, &quot;id&quot;: &quot;$(TargetName)&quot;, &quot;displayName&quot;: &quot;$(_PackNameJson)&quot;, &quot;version&quot;: &quot;$(Version)&quot;, &quot;platform&quot;: &quot;$(_PackPlatform)&quot;, $(_PackMinHost)&quot;files&quot;: [ $(_PackFiles) ] }</_PackManifest>
    </PropertyGroup>
    <!-- Lines is a list that is split at semicolons: one in the name must stay in its line. -->
    <WriteLinesToFile File="$(_PackStage)extension.json" Lines="$(_PackManifest.Replace(';', '%3B'))" Overwrite="true" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)" />

    <!-- The two tasks that touch the package file itself: a file that is held open (RFiDGear is installing from it) is a warning
         for a build that did not ask for a package, and the message that says where it is follows only a package that was written. -->
    <Delete Files="$(_PackFile)" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)" />
    <ZipDirectory SourceDirectory="$(_PackStage)" DestinationFile="$(_PackFile)" Overwrite="true" Condition="'$(MSBuildLastTaskResult)' == 'true'" ContinueOnError="$(_PackContinue)" />
    <Message Importance="high" Condition="'$(MSBuildLastTaskResult)' == 'true'" Text="Extension package: $(_PackFile)" />
  </Target>
</Project>
