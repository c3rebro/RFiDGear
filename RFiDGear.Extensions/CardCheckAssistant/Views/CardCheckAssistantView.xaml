<UserControl
    x:Class="RFiDGear.Extensions.CardCheckAssistant.Views.CardCheckAssistantView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:RFiDGear.Extensions.CardCheckAssistant.ViewModels"
    MinWidth="620"
    MinHeight="460">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Firebrick" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,2" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="OutcomeRow" DataType="{x:Type vm:TaskOutcomeRowViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Position" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TaskIndex" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Result" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ErrorCode" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Cell}" Text="{Binding Position}" />
                <TextBlock Grid.Column="1" Style="{StaticResource Cell}" Text="{Binding TaskIndex}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Cell}" Text="{Binding TaskType}" />
                <TextBlock x:Name="ResultCell" Grid.Column="3" Style="{StaticResource Cell}" Text="{Binding ResultText}" />
                <TextBlock Grid.Column="4" Style="{StaticResource Cell}" Text="{Binding ErrorCode}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TaskRowKind.Failure}">
                    <Setter TargetName="ResultCell" Property="Foreground" Value="Firebrick" />
                    <Setter TargetName="ResultCell" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TaskRowKind.Success}">
                    <Setter TargetName="ResultCell" Property="Foreground" Value="DarkGreen" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:TaskRowKind.Skipped}">
                    <Setter TargetName="ResultCell" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12" Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- what this page does, the reader and the project RFiDGear has open -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Strings[WindowHint]}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ReaderText}" />
            <TextBlock Text="{Binding OpenProjectText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OpenProjectText}" />
        </StackPanel>

        <!-- the values of the run -->
        <StackPanel x:Name="FieldsPanel" Grid.Row="1" IsEnabled="{Binding InputsEnabled}">
            <Label Content="{Binding Strings[ProjectLabel]}" Target="{Binding ElementName=ProjectBox}" Padding="0,0,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectBox" Grid.Column="0" Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button x:Name="BrowseButton" Grid.Column="1" Margin="6,0,0,0" Padding="12,2" Content="{Binding Strings[Browse]}" Command="{Binding BrowseCommand}" />
            </Grid>
            <TextBlock x:Name="ProjectErrorText" Style="{StaticResource ErrorText}" Text="{Binding ProjectError}"
                       Visibility="{Binding HasProjectError, Converter={StaticResource BoolToVisibility}}" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Label Content="{Binding Strings[JobNumberLabel]}" Target="{Binding ElementName=JobBox}" Padding="0,0,0,2" />
                    <TextBox x:Name="JobBox" Text="{Binding JobNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{Binding Strings[ChipNumberLabel]}" Target="{Binding ElementName=ChipBox}" Padding="0,0,0,2" />
                    <TextBox x:Name="ChipBox" Text="{Binding ChipNumber, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <Label Content="{Binding Strings[ReportTargetLabel]}" Target="{Binding ElementName=ReportBox}" Padding="0,8,0,2" />
            <TextBox x:Name="ReportBox" Text="{Binding ReportTargetPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock x:Name="ReportErrorText" Style="{StaticResource ErrorText}" Text="{Binding ReportTargetError}"
                       Visibility="{Binding HasReportTargetError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- run, progress, and what is wrong with the run as a whole -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" MinWidth="130" Padding="12,4" Content="{Binding Strings[RunButton]}" Command="{Binding RunCommand}" />
                <ProgressBar x:Name="ProgressIndicator" Width="140" Height="14" Margin="12,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding StatusText}" />
            </StackPanel>
            <TextBlock x:Name="RunErrorText" Style="{StaticResource ErrorText}" Text="{Binding RunError}"
                       Visibility="{Binding HasRunError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock x:Name="CloseHint" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding CloseHintText}"
                       Visibility="{Binding ShowCloseHint, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- the terminal outcome of the last run -->
        <StackPanel Grid.Row="3" Margin="0,12,0,4" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding Strings[ResultHeader]}" />
                <TextBlock FontWeight="SemiBold" Margin="8,0,0,0" Text="{Binding OutcomeText}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Text="{Binding ReasonText}"
                       Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding SummaryText}" />
        </StackPanel>

        <!-- one line per task -->
        <Grid Grid.Row="4" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Position" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TaskIndex" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Result" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ErrorCode" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="{Binding Strings[ColumnPosition]}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{Binding Strings[ColumnTaskIndex]}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{Binding Strings[ColumnType]}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="{Binding Strings[ColumnResult]}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="{Binding Strings[ColumnErrorCode]}" />
                    <Border Grid.Column="5" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible">
                <ItemsControl x:Name="ResultList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource OutcomeRow}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
