<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(OS)' != 'Windows_NT' ">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
    <!-- A real SQL engine for the order store's tests only; it is not shipped and the library does not use it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <!-- Microsoft.Data.Sqlite 10.0.1 brings SQLitePCLRaw.lib.e_sqlite3 2.1.11, whose SQLite (3.49.1) is older than 3.50.2 and has a
         flaw that can corrupt memory (CVE-2025-6965, GHSA-2m69-gcr7-jv3q; NuGet warns with NU1903 at every restore). A direct
         reference to a later version wins over it. TestDatabaseEngineTests asks the engine for its version, so a package that
         brings the old one back fails a test and not only a warning. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Fixtures\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- The steps of the hardware cases, run here against a scripted reader (see Reader/HilScenarioSelfCheckTests). -->
    <Compile Include="..\RFiDGear.HIL.Tests\ReaderScenarios.cs" Link="Reader\HilScenarios\ReaderScenarios.cs" />
    <!-- The settings file of the hardware tests: its parsing and lookup are tested here (Reader/HilSettingsTests). -->
    <Compile Include="..\RFiDGear.HIL.Tests\HilSettings.cs" Link="Reader\HilScenarios\HilSettings.cs" />
    <!-- The tasks and the vault of the secure-key hardware cases, checked here against a scripted reader and a dictionary
         as the vault (SecureKeys/HilSecureKeyScenarioSelfCheckTests). -->
    <Compile Include="..\RFiDGear.HIL.Tests\HilConstants.cs" Link="Reader\HilScenarios\HilConstants.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\HilSecureKeyTasks.cs" Link="Reader\HilScenarios\HilSecureKeyTasks.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\HilVault.cs" Link="Reader\HilScenarios\HilVault.cs" />
    <!-- The gate in front of the reader of the secure-key cases (SecureKeys/HilSecureKeyFixtureTests). It needs the fixture
         it wraps, and what that one needs. -->
    <Compile Include="..\RFiDGear.HIL.Tests\HilSecureKeyFixture.cs" Link="Reader\HilScenarios\HilSecureKeyFixture.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\HilFixture.cs" Link="Reader\HilScenarios\HilFixture.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\HilTaskBuilder.cs" Link="Reader\HilScenarios\HilTaskBuilder.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\HilFileSettings.cs" Link="Reader\HilScenarios\HilFileSettings.cs" />
    <Compile Include="..\RFiDGear.HIL.Tests\StaTestRunner.cs" Link="Reader\HilScenarios\HilStaTestRunner.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RFiDGear.Extensions\DesfirePluginSample\RFiDGear.Extensions.DesfirePluginSample.csproj" />
    <ProjectReference Include="..\RFiDGear.Extensions\CardCheckAssistant\RFiDGear.Extensions.CardCheckAssistant.csproj" />
    <ProjectReference Include="..\\RFiDGear\\RFiDGear.csproj" />
    <ProjectReference Include="..\RFiDGear.ExtensionSdk\RFiDGear.ExtensionSdk.csproj" />
    <ProjectReference Include="..\RFiDGear.Bridge.Contracts\RFiDGear.Bridge.Contracts.csproj" />
    <ProjectReference Include="..\RFiDGear.Bridge.SampleClient\RFiDGear.Bridge.SampleClient.csproj" />
    <ProjectReference Include="..\RFiDGear.ExtensionLibraries\CardCheck\RFiDGear.ExtensionLibraries.CardCheck.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures\minimal.rfPrj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Extension binaries built before the SDK split; loaded by LegacyExtensionCompatibilityTests, never compiled in. -->
    <Content Include="Fixtures\LegacyExtensions\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The approved public surface of RFiDGear.Contracts, compared by ApiSurface/ContractsApiSurfaceTests. -->
    <Content Include="ApiSurface\RFiDGear.Contracts.api.approved">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The approved public surface of RFiDGear.ExtensionSdk, compared by ApiSurface/ExtensionSdkApiSurfaceTests. -->
    <Content Include="ApiSurface\RFiDGear.ExtensionSdk.api.approved">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The approved public surface of RFiDGear.Bridge.Contracts, compared by ApiSurface/BridgeContractsApiSurfaceTests. -->
    <Content Include="ApiSurface\RFiDGear.Bridge.Contracts.api.approved">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
