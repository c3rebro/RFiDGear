<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RFiDGear.View.SamSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RFiDGear.View"
    Title="{Binding Title}"
    Width="640"
    MinWidth="560"
    MaxHeight="900"
    FontFamily="Segoe UI"
    FontWeight="Normal"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    ToolTipService.ShowDuration="30000"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KeySlotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Buttons -->
        <Grid Margin="0,10,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="CloseButton"
                Width="80"
                Height="26"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="{Binding CloseText}"
                IsCancel="True" />
        </Grid>

        <TextBlock
            x:Name="IntroText"
            Margin="4,0,4,8"
            DockPanel.Dock="Top"
            Text="{Binding IntroText}"
            TextWrapping="Wrap" />

        <!-- Everything below is off while a step runs. -->
        <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding AreInputsEnabled}">

            <!-- The reader of the SAM. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding ReaderLabel}" />
                <ComboBox
                    x:Name="ReaderBox"
                    Grid.Column="1"
                    Height="24"
                    Margin="4,2,4,2"
                    ItemsSource="{Binding ReaderNames}"
                    SelectedItem="{Binding SelectedReader, Mode=TwoWay}">
                    <AutomationProperties.Name>
                        <Binding Path="ReaderLabel" />
                    </AutomationProperties.Name>
                </ComboBox>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Height="24"
                    Margin="0,2,4,2"
                    Padding="8,2"
                    Command="{Binding RefreshCommand}"
                    Content="{Binding RefreshText}" />
                <Button
                    x:Name="CheckButton"
                    Grid.Column="3"
                    Height="24"
                    Margin="0,2,4,2"
                    Padding="8,2"
                    Command="{Binding CheckCommand}"
                    Content="{Binding CheckText}"
                    ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding CheckToolTip}" />
                    </Button.ToolTip>
                </Button>
            </Grid>

            <TextBlock
                x:Name="StateText"
                Margin="4,2,4,0"
                FontWeight="SemiBold"
                Text="{Binding StateText}"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="VersionText"
                Margin="4,0,4,6"
                Foreground="Gray"
                Text="{Binding VersionText}"
                TextWrapping="Wrap" />

            <!-- The master key: entry 0, version 0. A new SAM has the factory key. -->
            <Border
                Margin="0,0,0,8"
                Padding="6"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="{Binding MasterHeader}" />

                    <CheckBox
                        x:Name="FactoryKeyBox"
                        Margin="4,2,4,4"
                        Content="{Binding FactoryKeyText}"
                        IsChecked="{Binding MasterUsesFactoryKey, Mode=TwoWay}">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding FactoryKeyToolTip}" />
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding StoredKeyLabel}" />
                        <ComboBox
                            x:Name="MasterStoredBox"
                            Grid.Column="1"
                            Height="24"
                            Margin="4,2,4,2"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding StoredKeys}"
                            SelectedValue="{Binding MasterReference, Mode=TwoWay}"
                            SelectedValuePath="Reference">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MasterUsesFactoryKey}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding StoredKeyToolTip}" />
                            </ComboBox.ToolTip>
                            <AutomationProperties.Name>
                                <Binding Path="StoredKeyLabel" />
                            </AutomationProperties.Name>
                        </ComboBox>

                        <!-- The box of the key is there only when the key is typed: with the factory key or a stored one there is
                             nothing to type, and an empty box that is red would look like a mistake. -->
                        <TextBlock
                            Grid.Row="1"
                            Margin="4,2,4,2"
                            VerticalAlignment="Center"
                            Text="{Binding KeyDigitsLabel}"
                            TextWrapping="Wrap"
                            Visibility="{Binding MasterKeyIsTyped, Converter={StaticResource BoolToVisConv}}" />
                        <!-- Hidden until the person asks to see it, limited to 32 digits, green for a key and red for anything else.
                             Enter authenticates when that can be done; it never closes the window. -->
                        <local:KeyEntryBox
                            x:Name="MasterKeyBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="4,2,4,2"
                            EnterPressed="MasterKeyBox_EnterPressed"
                            HexLength="32"
                            IsEnabled="{Binding MasterKeyIsTyped}"
                            Label="{Binding KeyDigitsLabel}"
                            ShowKeyText="{Binding ShowKeyText}"
                            ShowKeyToolTip="{Binding ShowKeyToolTip}"
                            Visibility="{Binding MasterKeyIsTyped, Converter={StaticResource BoolToVisConv}}" />
                    </Grid>

                    <StackPanel
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="AuthenticateButton"
                            Height="24"
                            Margin="4,0,4,0"
                            Padding="10,2"
                            Click="Authenticate_Click"
                            Content="{Binding AuthenticateText}"
                            IsEnabled="{Binding CanAuthenticate}"
                            ToolTipService.ShowOnDisabled="True">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding AuthenticateToolTip}" />
                            </Button.ToolTip>
                        </Button>
                        <Button
                            x:Name="ActivateButton"
                            Height="24"
                            Margin="4,0,4,0"
                            Padding="10,2"
                            Click="Activate_Click"
                            Content="{Binding ActivateText}"
                            IsEnabled="{Binding CanActivate}"
                            ToolTipService.ShowOnDisabled="True">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding ActivateToolTip}" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The key that is written: an AES-128 PICC key into an entry from 1 to 127. -->
            <Border
                Margin="0,0,0,8"
                Padding="6"
                BorderBrush="LightGray"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Text="{Binding NewKeyHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="175" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding EntryLabel}" TextWrapping="Wrap" />
                        <TextBox
                            x:Name="EntryBox"
                            Grid.Column="1"
                            Width="80"
                            Height="24"
                            Margin="4,2,4,2"
                            HorizontalAlignment="Left"
                            VerticalContentAlignment="Center"
                            MaxLength="3"
                            Text="{Binding EntryNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEntryNumberValid}" Value="False">
                                            <Setter Property="Background" Value="MistyRose" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding EntryToolTip}" />
                            </TextBox.ToolTip>
                            <AutomationProperties.Name>
                                <Binding Path="EntryLabel" />
                            </AutomationProperties.Name>
                        </TextBox>

                        <TextBlock
                            Grid.Row="1"
                            Margin="4,2,4,2"
                            VerticalAlignment="Center"
                            Text="{Binding EntryKindLabel}" />
                        <ComboBox
                            x:Name="EntryKindBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="24"
                            Margin="4,2,4,2"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding EntryKinds}"
                            SelectedValue="{Binding SelectedEntryKind, Mode=TwoWay}"
                            SelectedValuePath="Kind">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding EntryKindToolTip}" />
                            </ComboBox.ToolTip>
                            <AutomationProperties.Name>
                                <Binding Path="EntryKindLabel" />
                            </AutomationProperties.Name>
                        </ComboBox>
                        <TextBlock
                            Grid.Row="2"
                            Margin="4,2,4,2"
                            VerticalAlignment="Center"
                            Text="{Binding StoredKeyLabel}" />
                        <ComboBox
                            x:Name="NewStoredBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="24"
                            Margin="4,2,4,2"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding StoredKeys}"
                            SelectedValue="{Binding NewKeyReference, Mode=TwoWay}"
                            SelectedValuePath="Reference">
                            <ComboBox.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding StoredKeyToolTip}" />
                            </ComboBox.ToolTip>
                            <AutomationProperties.Name>
                                <Binding Path="StoredKeyLabel" />
                            </AutomationProperties.Name>
                        </ComboBox>

                        <TextBlock
                            Grid.Row="3"
                            Margin="4,2,4,2"
                            VerticalAlignment="Center"
                            Text="{Binding KeyDigitsLabel}"
                            TextWrapping="Wrap"
                            Visibility="{Binding NewKeyIsTyped, Converter={StaticResource BoolToVisConv}}" />
                        <local:KeyEntryBox
                            x:Name="NewKeyBox"
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="4,2,4,2"
                            EnterPressed="NewKeyBox_EnterPressed"
                            HexLength="32"
                            IsEnabled="{Binding NewKeyIsTyped}"
                            Label="{Binding KeyDigitsLabel}"
                            ShowKeyText="{Binding ShowKeyText}"
                            ShowKeyToolTip="{Binding ShowKeyToolTip}"
                            Visibility="{Binding NewKeyIsTyped, Converter={StaticResource BoolToVisConv}}" />
                    </Grid>

                    <StackPanel
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="WriteButton"
                            Height="24"
                            Margin="4,0,4,0"
                            Padding="10,2"
                            Click="Write_Click"
                            Content="{Binding WriteText}"
                            IsEnabled="{Binding CanWrite}"
                            ToolTipService.ShowOnDisabled="True">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding WriteToolTip}" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- What the last step said, green or red, and then what all of them said. -->
        <TextBlock
            Margin="4,0,4,2"
            DockPanel.Dock="Top"
            FontWeight="SemiBold"
            Text="{Binding StatusLabel}" />
        <TextBlock
            x:Name="ResultText"
            Margin="4,0,4,4"
            DockPanel.Dock="Top"
            Text="{Binding ResultText}"
            TextWrapping="Wrap"
            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisConv}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="Green" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                            <Setter Property="Foreground" Value="Red" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBox
            x:Name="StatusBox"
            MinHeight="90"
            MaxHeight="150"
            IsReadOnly="True"
            Text="{Binding StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto">
            <AutomationProperties.Name>
                <Binding Path="StatusLabel" />
            </AutomationProperties.Name>
        </TextBox>
    </DockPanel>
</Window>
