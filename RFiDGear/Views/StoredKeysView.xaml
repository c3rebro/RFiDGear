<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RFiDGear.View.StoredKeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RFiDGear.View"
    Title="{Binding Title}"
    Width="560"
    MinWidth="460"
    MaxHeight="780"
    FontFamily="Segoe UI"
    FontWeight="Normal"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    ToolTipService.ShowDuration="30000"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KeySlotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Buttons -->
        <Grid Margin="0,10,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="CloseButton"
                Width="80"
                Height="26"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="{Binding CloseText}"
                IsCancel="True" />
        </Grid>

        <!-- Whether a program can supply keys. Shown always: the window is where a person goes to see what keys there are. -->
        <TextBlock
            x:Name="SupplierStatus"
            Margin="4,8,4,0"
            DockPanel.Dock="Bottom"
            Text="{Binding SupplierStatusText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#B45F06" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SupplierIsConnected}" Value="True">
                            <Setter Property="Foreground" Value="Green" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock
            x:Name="IntroText"
            Margin="4,0,4,8"
            DockPanel.Dock="Top"
            Text="{Binding IntroText}"
            TextWrapping="Wrap" />

        <!-- The stored keys, by name. -->
        <TextBlock
            Margin="4,0,4,4"
            DockPanel.Dock="Top"
            FontWeight="SemiBold"
            Text="{Binding ListHeader}" />

        <Border
            Margin="0,0,0,10"
            Padding="4"
            BorderBrush="LightGray"
            BorderThickness="1"
            DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock
                    x:Name="NoKeysText"
                    Margin="4,2,4,2"
                    Foreground="Gray"
                    Text="{Binding NoKeysText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding ShowNoKeysText, Converter={StaticResource BoolToVisConv}}" />
                <TextBlock
                    x:Name="ListErrorText"
                    Margin="4,2,4,2"
                    Foreground="Red"
                    Text="{Binding ListErrorText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasListError, Converter={StaticResource BoolToVisConv}}" />
                <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="KeyList" ItemsSource="{Binding Keys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="ReferenceText"
                                        Margin="4,0,4,0"
                                        VerticalAlignment="Center"
                                        Text="{Binding Reference}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.ToolTip>
                                            <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding Reference}" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <Button
                                        x:Name="RemoveButton"
                                        Grid.Column="1"
                                        Height="24"
                                        Margin="4,0,4,0"
                                        Padding="8,2"
                                        Command="{Binding RemoveCommand}"
                                        Content="{Binding RemoveText}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding RemoveToolTip}" />
                                        </Button.ToolTip>
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="RemoveText" />
                                                <Binding Path="Reference" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Storing a key under a name. The key is entered hidden and cleared after. -->
        <StackPanel x:Name="AddPanel">
            <TextBlock
                Margin="4,0,4,4"
                FontWeight="SemiBold"
                Text="{Binding AddHeader}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding NameLabel}" />
                <TextBox
                    x:Name="NameBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="24"
                    Margin="4,2,4,2"
                    VerticalContentAlignment="Center"
                    MaxLength="{Binding MaxReferenceLength}"
                    Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.ToolTip>
                        <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding NameToolTip}" />
                    </TextBox.ToolTip>
                    <AutomationProperties.Name>
                        <Binding Path="NameLabel" />
                    </AutomationProperties.Name>
                </TextBox>

                <TextBlock Grid.Row="1" Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding KindLabel}" />
                <ComboBox
                    x:Name="KindBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="24"
                    Margin="4,2,4,2"
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding KeyKinds}"
                    SelectedValue="{Binding SelectedHexLength, Mode=TwoWay}"
                    SelectedValuePath="HexLength">
                    <ComboBox.ToolTip>
                        <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding KindToolTip}" />
                    </ComboBox.ToolTip>
                    <AutomationProperties.Name>
                        <Binding Path="KindLabel" />
                    </AutomationProperties.Name>
                </ComboBox>
            </Grid>

            <TextBlock Margin="4,6,4,2" Text="{Binding KeyPrompt}" TextWrapping="Wrap" />
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Hidden until the person asks to see it, limited to the digits of the key, green for a key and red for anything else.
                     Enter stores the key (when it can be stored); it never closes the window and so never throws a key away. -->
                <local:KeyEntryBox
                    x:Name="KeyBox"
                    Margin="4,2,4,2"
                    EnterPressed="KeyBox_EnterPressed"
                    HexLength="{Binding SelectedHexLength}"
                    Label="{Binding KeyPrompt}"
                    ShowKeyText="{Binding ShowKeyText}"
                    ShowKeyToolTip="{Binding ShowKeyToolTip}" />
                <!-- A key is stored when the name is valid and the box says that the key is one. -->
                <Button
                    x:Name="StoreButton"
                    Grid.Column="1"
                    Height="24"
                    Margin="0,2,4,2"
                    Padding="6,2"
                    Click="StoreKey_Click"
                    Content="{Binding StoreButtonText}"
                    ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="{Binding CanStoreKey}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyValid, ElementName=KeyBox}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ToolTip>
                        <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding StoreToolTip}" />
                    </Button.ToolTip>
                </Button>
            </Grid>

            <TextBlock
                x:Name="ResultText"
                Margin="4,2,4,0"
                Text="{Binding ResultText}"
                TextWrapping="Wrap"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisConv}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="Green" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
