<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RFiDGear.View.DesfireAppKeyDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dal="clr-namespace:RFiDGear.Infrastructure"
    Title="{Binding Caption}"
    Width="520"
    MinWidth="380"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    FontFamily="Segoe UI"
    FontWeight="Normal">
    <Window.Resources>
        <dal:DESFireKeyTypeToMaxLengthConverter x:Key="DESFireKeyMaxLengthConv" />
    </Window.Resources>
    <StackPanel Margin="10">

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Header row -->
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="4,0,4,4" FontWeight="SemiBold" Text="Application Master Key (hex)" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="4,0,4,4" FontWeight="SemiBold" Text="Enc. Type" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="4,0,0,4" FontWeight="SemiBold" Text="Key No." />

            <!-- Key value -->
            <TextBox Grid.Row="1" Grid.Column="0" Margin="4,2,4,2" Height="24" VerticalContentAlignment="Center"
                     MaxLength="{Binding SelectedKeyType, Converter={StaticResource DESFireKeyMaxLengthConv}}" Text="{Binding AppKeyHex, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Resources>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsValidAppKeyHex}" Value="True">
                                <Setter Property="Foreground" Value="Green" />
                                <Setter Property="Background" Value="White" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsValidAppKeyHex}" Value="False">
                                <Setter Property="Foreground" Value="Black" />
                                <Setter Property="Background" Value="Red" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,2,4,2" Height="24"
                      ItemsSource="{Binding AvailableEncryptionTypes}"
                      SelectedItem="{Binding SelectedKeyType, Mode=TwoWay}" />

            <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,2,0,2" Height="24"
                      ItemsSource="{Binding AvailableKeyNumbers}"
                      SelectedItem="{Binding SelectedKeyNumber, Mode=TwoWay}" />
        </Grid>

        <!-- Buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Width="80" Height="26" Margin="0,0,8,0"
                    Command="{Binding OkCommand}" Content="OK" IsDefault="True" />
            <Button Grid.Column="2" Width="80" Height="26"
                    Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
        </Grid>

    </StackPanel>
</Window>
