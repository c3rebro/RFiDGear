<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="RFiDGear.View.KeyManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="{Binding Title}"
    Width="560"
    MinWidth="460"
    MaxHeight="780"
    FontFamily="Segoe UI"
    FontWeight="Normal"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    ToolTipService.ShowDuration="30000"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KeySlotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Buttons -->
        <Grid Margin="0,10,0,0" DockPanel.Dock="Bottom">
            <Button
                x:Name="CloseButton"
                Width="80"
                Height="26"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="{Binding CloseText}"
                IsCancel="True" />
        </Grid>

        <!-- Whether a program can supply keys; only shown while a slot is named in its key store. -->
        <TextBlock
            x:Name="SupplierStatus"
            Margin="4,8,4,0"
            DockPanel.Dock="Bottom"
            Text="{Binding SupplierStatusText}"
            TextWrapping="Wrap"
            Visibility="{Binding ShowSupplierStatus, Converter={StaticResource BoolToVisConv}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#B45F06" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SupplierIsConnected}" Value="True">
                            <Setter Property="Foreground" Value="Green" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock
            x:Name="IntroText"
            Margin="4,0,4,8"
            DockPanel.Dock="Top"
            Text="{Binding IntroText}"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="NoSlotsText"
            Margin="4,0,4,8"
            DockPanel.Dock="Top"
            Text="{Binding NoSlotsText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasRows}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl
                x:Name="SlotList"
                Grid.IsSharedSizeScope="True"
                ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,8"
                            Padding="0,0,0,8"
                            BorderBrush="LightGray"
                            BorderThickness="0,0,0,1">
                            <StackPanel>

                                <!-- The slot and the switch between a typed key and a reference. The buttons of all rows are as wide as the widest. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ModeButtonColumn" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Margin="4,0,4,4"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding SlotName}" />
                                    <Button
                                        x:Name="ModeButton"
                                        Grid.Column="1"
                                        Height="24"
                                        Margin="4,0,0,4"
                                        Padding="6,2"
                                        Command="{Binding ToggleModeCommand}"
                                        Content="{Binding ModeButtonText}">
                                        <Button.ToolTip>
                                            <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding ModeToolTip}" />
                                        </Button.ToolTip>
                                        <AutomationProperties.Name>
                                            <MultiBinding StringFormat="{}{0}: {1}">
                                                <Binding Path="SlotName" />
                                                <Binding Path="ModeButtonText" />
                                            </MultiBinding>
                                        </AutomationProperties.Name>
                                    </Button>
                                </Grid>

                                <TextBlock
                                    x:Name="TypedKeyText"
                                    Margin="4,0,4,0"
                                    Foreground="Gray"
                                    Text="{Binding TypedKeyText}"
                                    Visibility="{Binding UsesTypedKey, Converter={StaticResource BoolToVisConv}}" />

                                <!-- The key as a reference. -->
                                <StackPanel x:Name="ReferencePanel" Visibility="{Binding IsReferenceMode, Converter={StaticResource BoolToVisConv}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding KeyStoreLabel}" />
                                        <ComboBox
                                            x:Name="ProviderBox"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="4,2,4,2"
                                            ItemsSource="{Binding Providers}"
                                            SelectedValue="{Binding ProviderId, Mode=TwoWay}"
                                            SelectedValuePath="Id">
                                            <ComboBox.ToolTip>
                                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding ProviderToolTip}" />
                                            </ComboBox.ToolTip>
                                            <AutomationProperties.Name>
                                                <MultiBinding StringFormat="{}{0}: {1}">
                                                    <Binding Path="SlotName" />
                                                    <Binding Path="KeyStoreLabel" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="Transparent">
                                                        <Grid.ToolTip>
                                                            <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding ToolTip}" />
                                                        </Grid.ToolTip>
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Margin="4,2,4,2" VerticalAlignment="Center" Text="{Binding KeyNameLabel}" />
                                        <TextBox
                                            x:Name="ReferenceBox"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Height="24"
                                            Margin="4,2,4,2"
                                            VerticalContentAlignment="Center"
                                            MaxLength="{Binding MaxReferenceLength}"
                                            Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.ToolTip>
                                                <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding ReferenceToolTip}" />
                                            </TextBox.ToolTip>
                                            <AutomationProperties.Name>
                                                <MultiBinding StringFormat="{}{0}: {1}">
                                                    <Binding Path="SlotName" />
                                                    <Binding Path="KeyNameLabel" />
                                                </MultiBinding>
                                            </AutomationProperties.Name>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReferenceValid}" Value="True">
                                                            <Setter Property="Foreground" Value="Green" />
                                                            <Setter Property="Background" Value="White" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReferenceValid}" Value="False">
                                                            <Setter Property="Foreground" Value="Black" />
                                                            <Setter Property="Background" Value="Red" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>

                                    <!-- Storing a key: only for a key store that takes keys from here. The key is entered hidden and cleared after. -->
                                    <StackPanel x:Name="StorePanel" Visibility="{Binding ProviderOffersStoreKey, Converter={StaticResource BoolToVisConv}}">
                                        <TextBlock Margin="4,6,4,2" Text="{Binding KeyPrompt}" TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Enter stores the key (when it can be stored); it never closes the window and so never throws a key away. -->
                                            <PasswordBox
                                                x:Name="KeyBox"
                                                Height="24"
                                                Margin="4,2,4,2"
                                                VerticalContentAlignment="Center"
                                                MaxLength="0"
                                                PreviewKeyDown="KeyBox_PreviewKeyDown">
                                                <AutomationProperties.Name>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="SlotName" />
                                                        <Binding Path="KeyPrompt" />
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </PasswordBox>
                                            <Button
                                                x:Name="StoreButton"
                                                Grid.Column="1"
                                                Height="24"
                                                Margin="0,2,4,2"
                                                Padding="6,2"
                                                Click="StoreKey_Click"
                                                Content="{Binding StoreButtonText}"
                                                IsEnabled="{Binding CanStoreKey}"
                                                ToolTipService.ShowOnDisabled="True">
                                                <Button.ToolTip>
                                                    <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding StoreToolTip}" />
                                                </Button.ToolTip>
                                                <AutomationProperties.Name>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="SlotName" />
                                                        <Binding Path="StoreButtonText" />
                                                    </MultiBinding>
                                                </AutomationProperties.Name>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="ResultText"
                                        Margin="4,2,4,0"
                                        Text="{Binding ResultText}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisConv}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
