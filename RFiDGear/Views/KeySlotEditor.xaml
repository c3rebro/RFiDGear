<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="RFiDGear.View.KeySlotEditor"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RFiDGear.View"
    ToolTipService.ShowDuration="30000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KeySlotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The key as it always was: the box that the view brings, with its own margins and its own data context, the task.
             While the slot is named by a reference nothing can be typed into it: the slot never uses its key. -->
        <Border x:Name="EmbeddedHost" Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State.IsReferenceMode, ElementName=Self}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Over the box while the slot is named by a reference. The box is empty then, which the view colours red as an invalid
             key; a plain grey field in its place says that the key is not typed here. It lies exactly over the box. -->
        <Border
            x:Name="ReferenceCover"
            Grid.Row="0"
            Margin="{Binding CoverMargin, ElementName=Self}"
            Background="#F0F0F0"
            BorderBrush="#C4C4C4"
            BorderThickness="1"
            IsHitTestVisible="False"
            Visibility="{Binding State.IsReferenceMode, ElementName=Self, Converter={StaticResource BoolToVisConv}, FallbackValue=Collapsed}" />

        <!-- Where the key comes from: the key store and the name. Only while a reference is used; collapsed it has no height, so a
             slot with a typed key looks exactly as it always did. The key manager is where it is chosen. The line takes the width of
             the key box and asks for none of its own: a column that is as wide as its content (the data explorer has such) must not
             grow with a long name. -->
        <local:LineWithoutWidth
            x:Name="CaptionFrame"
            Grid.Row="1"
            Margin="{Binding CaptionMargin, ElementName=Self}"
            Visibility="{Binding State.IsReferenceMode, ElementName=Self, Converter={StaticResource BoolToVisConv}, FallbackValue=Collapsed}">
            <TextBlock
                x:Name="CaptionRow"
                Text="{Binding State.ReferenceCaption, ElementName=Self}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <!-- A text does not grey itself out with the group that it is in, as the labels beside it do. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <TextBlock.ToolTip>
                    <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="{Binding State.ReferenceDetail, ElementName=Self}" />
                </TextBlock.ToolTip>
            </TextBlock>
        </local:LineWithoutWidth>
    </Grid>
</UserControl>
