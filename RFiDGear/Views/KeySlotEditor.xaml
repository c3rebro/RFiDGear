<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="RFiDGear.View.KeySlotEditor"
    x:Name="Self"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    ToolTipService.ShowDuration="30000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="KeySlotStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The key as it always was: the box that the view brings, with its own margins and its own data context, the task. The box
         fills the cell of this control, so a box that stretches to its row is as high as the row makes it. While the slot is named by
         a reference nothing can be typed into the box, and it shows that reference in the place of the key (the code behind does that). -->
    <Border x:Name="EmbeddedHost">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State.IsReferenceMode, ElementName=Self}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</UserControl>
