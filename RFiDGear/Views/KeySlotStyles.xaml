<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The tooltips of the key slot controls. A tooltip that is given as text shows it on one line, and a long text runs off the
         screen. This one wraps at a maximum width. Use it as an element: <ToolTip Style="{StaticResource KeySlotToolTipStyle}" Content="..." />. -->
    <Style x:Key="KeySlotToolTipStyle" TargetType="ToolTip">
        <Setter Property="MaxWidth" Value="380" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
