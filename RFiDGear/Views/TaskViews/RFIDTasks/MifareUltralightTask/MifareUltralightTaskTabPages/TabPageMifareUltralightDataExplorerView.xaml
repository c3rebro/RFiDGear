<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="RFiDGear.View.TabPageMifareUltralightDataExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dal="clr-namespace:RFiDGear.Infrastructure"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConv" />
        <dal:BindingProxy x:Key="proxy" Data="{Binding}" />
        <dal:ResourceLoader x:Key="Localization" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <GroupBox
            Grid.Column="0"
            Margin="8,8,4,8"
            Header="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='groupBoxHeaderMifareUltralightPages'}"
            IsEnabled="{Binding IsDataExplorerEditTabEnabled}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label
                        Grid.Column="0"
                        Margin="4,0,4,0"
                        VerticalContentAlignment="Center"
                        Content="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='labelContentMifareUltralightStartPage'}" />
                    <TextBox
                        Grid.Column="1"
                        Height="26"
                        Margin="4,0,4,0"
                        VerticalContentAlignment="Center"
                        FontFamily="Lucida Console"
                        Text="{Binding StartPage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Label
                        Grid.Column="2"
                        Margin="12,0,4,0"
                        VerticalContentAlignment="Center"
                        Content="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='labelContentMifareUltralightPageCount'}"
                        Visibility="{Binding IsReadTask, Converter={StaticResource BoolToVisConv}}" />
                    <TextBox
                        Grid.Column="3"
                        Height="26"
                        Margin="4,0,4,0"
                        VerticalContentAlignment="Center"
                        FontFamily="Lucida Console"
                        Text="{Binding PageCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsReadTask, Converter={StaticResource BoolToVisConv}}" />
                </Grid>
                <DataGrid
                    Grid.Row="1"
                    MinHeight="120"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding PageRows}"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding PageNumber}"
                            Header="{Binding Data.LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='dataGridHeaderMifareUltralightPage', Source={StaticResource proxy}}"
                            IsReadOnly="True" />
                        <DataGridTemplateColumn
                            Width="*"
                            Header="{Binding Data.LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='dataGridHeaderMifareUltralightData', Source={StaticResource proxy}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        BorderThickness="0"
                                        FontFamily="Lucida Console"
                                        IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                                        MaxLength="8"
                                        Text="{Binding Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        VerticalContentAlignment="Center">
                                        <TextBox.Style>
                                            <Style TargetType="{x:Type TextBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                        <Setter Property="Foreground" Value="Green" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Background" Value="#FFF4B6B6" />
                                                        <Setter Property="Foreground" Value="Black" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Margin="2,1,2,1"
                                        Padding="8,0,8,0"
                                        Command="{Binding DataContext.RemovePageCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Data.LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='buttonContentMifareUltralightRemovePage', Source={StaticResource proxy}}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Button
                    Grid.Row="2"
                    Height="26"
                    MinWidth="140"
                    Margin="0,8,0,4"
                    Padding="5,2"
                    HorizontalAlignment="Left"
                    Command="{Binding AddPageCommand}"
                    Content="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='buttonContentMifareUltralightAddPage'}"
                    Visibility="{Binding IsWriteTask, Converter={StaticResource BoolToVisConv}}" />
            </Grid>
        </GroupBox>
        <GroupBox
            Grid.Column="1"
            Width="270"
            Margin="4,8,8,8"
            Header="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='groupBoxHeaderMifareUltralightRunNow'}"
            IsEnabled="{Binding IsDataExplorerEditTabEnabled}">
            <StackPanel Margin="4,8,4,4">
                <Button
                    Height="26"
                    Margin="4,0,4,8"
                    Padding="5,2"
                    Command="{Binding ReadDataCommand}"
                    Content="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='buttonContentMifareClassicSetupReadData'}"
                    Visibility="{Binding IsReadTask, Converter={StaticResource BoolToVisConv}}" />
                <Button
                    Height="26"
                    Margin="4,0,4,8"
                    Padding="5,2"
                    Command="{Binding WriteDataCommand}"
                    Content="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='buttonContentMifareClassicSetupWriteData'}"
                    Visibility="{Binding IsWriteTask, Converter={StaticResource BoolToVisConv}}" />
                <TextBlock
                    Margin="4,4,4,0"
                    Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                    Text="{Binding LocalizationResourceSet, Converter={StaticResource Localization}, ConverterParameter='textBlockMifareUltralightRunNowHint'}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
